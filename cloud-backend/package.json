{
  "name": "echoideal-cloud-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run build && node dist/src/index.js",
    "dev:watch": "tsc -p tsconfig.json -w",
    "dev:serve": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "license:create:dev": "npm run build && node dist/src/scripts/create-dev-license.js",
    "license:create:paid": "npm run build && node dist/src/scripts/create-paid-license.js",
    "check-endpoints": "node dist/src/scripts/check-endpoints.js",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.2",
    "@prisma/client": "^6.16.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "stripe": "^18.0.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.16.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
